<?xml version="1.0" encoding="utf-8"?>
<!--
    Palette: "audiogram paper".
    Drawn from clinical audiometry charts rather than oscilloscope phosphor -
    cool paper, ink-navy rules, and the red/blue pair used to plot hearing
    thresholds. Red carries the live signal, blue marks the target.
    Dark equivalents live in values-night/colors.xml.
-->
<resources>
    <!-- Surfaces -->
    <color name="paper">#F2F4F7</color>
    <color name="panel">#FFFFFF</color>

    <!-- Text -->
    <color name="ink">#0E2035</color>
    <color name="mute">#667A8F</color>

    <!-- Hairlines, dividers, chart grid -->
    <color name="rule">#D3DCE6</color>

    <!-- Signal red: the spectrum trace and the recording state -->
    <color name="trace">#D6402F</color>
    <color name="trace_pressed">#B4321F</color>
    <color name="trace_fill">#33D6402F</color>

    <!-- Marker blue: the target frequency and input focus -->
    <color name="mark">#1D6FB8</color>

    <color name="on_trace">#FFFFFF</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
