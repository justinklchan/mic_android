<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Microphone" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/trace</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/panel</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOutline">@color/rule</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorHighlight">@color/rule</item>
    </style>

    <!--
        Type system. Two roles, and the split carries meaning:
        monospace = measured data (it has tabular figures, so digits stop
        jittering as values update), condensed caps = panel labels, the way
        they are silkscreened onto real instruments.
    -->

    <style name="Text.Readout" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">56sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Label" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/mute</item>
    </style>

    <style name="Text.Unit" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/mute</item>
    </style>

    <style name="Text.Caption" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/mute</item>
    </style>

    <!-- Numeric parameter field: a spec-sheet value, not a form input. -->
    <style name="Field.Number" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Button.Transport" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

</resources>
